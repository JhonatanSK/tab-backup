{
  "name": "tabbackup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node scripts/assets.mjs && vite build && node scripts/check-build.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "pnpm build && python3 scripts/package.py",
    "release": "pnpm lint && pnpm typecheck && pnpm test && pnpm package",
    "perf": "vitest run tests/performance.test.ts"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.0",
    "prettier": "3.9.9",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/node": "24.19.1",
    "sharp": "0.35.5",
    "fake-indexeddb": "6.2.5"
  }
}
